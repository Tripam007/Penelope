# PENELOPE Environment Configuration
# Tagline: "Data today. Safer tomorrows."
# Pillars: Predict · Prepare · Protect

# App Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=penelope-super-secret-key-change-in-production-2026

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database (PostgreSQL + PostGIS)
# For local dev without docker, can use sqlite or postgres
DATABASE_URL=postgresql+asyncpg://penelope:penelope_dev_secret@localhost:5432/penelope_db
DATABASE_SYNC_URL=postgresql://penelope:penelope_dev_secret@localhost:5432/penelope_db
# SQLite fallback for quick testing without docker postgis running:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./penelope.db

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Ingestion & External APIs
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Sensor Simulation Daemon
SIMULATE_SENSORS=True
SIMULATION_INTERVAL_SECONDS=15

# ML Inference Configuration
MODEL_DIR=ml/models
ACTIVE_TABULAR_MODEL=lightgbm_flood_classifier.joblib
ACTIVE_LSTM_MODEL=lstm_hydrology_model.pt

# Alert Delivery Channels (Optional - Graceful Degradation)
# If left empty, alerts are recorded as skipped_unconfigured and shown in UI
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@penelope-flood.org

WEBHOOK_ALERT_URL=

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_DEFAULT_LAT=30.3753
NEXT_PUBLIC_DEFAULT_LON=79.3242
NEXT_PUBLIC_DEFAULT_ZOOM=9
